# Analytics (ADR-003/007). Public by design: a PostHog project API key is not a secret. Unset = analytics is a clean no-op.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# prod | preview | dev | test (dev/test THROW on a PII/allow-list violation; prod drops the event)
PUBLIC_APP_ENV=dev
# Where the "Sign in" link points. Unset = plain text, never a fake link.
PUBLIC_SIGNIN_URL=
