---
interface Props {
  title: string;
  id: string;
}
const { title, id } = Astro.props;
---

<section aria-labelledby={`${id}-title`} class="border-t border-border-primary">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <h2 id={`${id}-title`} class="font-display text-3xl font-bold text-text-primary sm:text-4xl">{title}</h2>
    <div class="mt-5 max-w-prose text-text-secondary"><slot /></div>
  </div>
</section>
